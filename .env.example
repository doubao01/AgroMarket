# 数据库配置（docker-compose 使用）
MYSQL_ROOT_PASSWORD=root_change_me
MYSQL_DATABASE=agro_market
MYSQL_USER=agromarket
MYSQL_PASSWORD=change_me_db_password

# JWT 密钥：生产环境必须替换为唯一随机字符串，长度 >= 32 字节
JWT_SECRET_KEY=please_change_this_to_a_unique_secret_at_least_32_bytes

# API 对外端口
API_PORT=8080

# 允许的前端来源（CORS）
CORS_ORIGIN=http://localhost:5173

# 开发模拟支付（仅开发环境可开启；生产必须留空/false）
PAYMENT_MOCK_ENABLED=false

# 微信支付（配置齐全后渠道可用，留空表示未启用）
# PrivateKey 为商户 API 证书私钥 apiclient_key.pem 的 PEM 内容
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_APIV3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_NOTIFY_URL=

# 支付宝（配置齐全后渠道可用，留空表示未启用）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

# 多节点联动（单节点部署默认关闭；多级部署见 docker-compose.cluster.yml）
FEDERATION_ENABLED=false
FEDERATION_NODE_CODE=
FEDERATION_NODE_NAME=
FEDERATION_LEVEL=COUNTY
FEDERATION_REGION_CODE=
# SYMMETRIC 模式必填(>=32 字节, 全网一致)；ASYMMETRIC 模式可留空
FEDERATION_SHARED_KEY=
FEDERATION_TOKEN_MODE=SYMMETRIC
FEDERATION_ROLE=BUSINESS
FEDERATION_AUTOSYNC=true
FEDERATION_SYNC_INTERVAL_MINUTES=30
FEDERATION_INCLUDE_SELF_IN_AGGREGATE=true