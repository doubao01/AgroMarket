root = true

# 说明: 未强制 end_of_line —— 仓库历史文件 CRLF/LF 混存, 在此统一会引发全量重写。
# 若后续要规范化行尾, 应改用 .gitattributes 并单独提交一次, 不要混在功能改动里。

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.{sql,yml,yaml}]
indent_size = 2

[*.md]
# Markdown 的行尾双空格是换行语法, 不能裁掉
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
