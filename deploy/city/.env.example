# ===== 市级节点环境变量 =====
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，切勿提交真实密钥。

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=agro_market
MYSQL_USER=agromarket
MYSQL_PASSWORD=change_me_db_password

# ---- 用户登录 JWT（>=32 字节，可与其他节点不同）----
JWT_SECRET_KEY=change_me_jwt_secret_key_at_least_32_bytes_long

# ---- 联动共享密钥（>=32 字节，全网所有节点必须完全一致）----
FEDERATION_SHARED_KEY=change_me_federation_shared_key_at_least_32_bytes

# ---- 本节点标识（市级）----
FEDERATION_NODE_CODE=node-zhoukou
FEDERATION_NODE_NAME=周口市农贸通
FEDERATION_REGION_CODE=411600

# ---- 令牌模式: SYMMETRIC / ASYMMETRIC（生产建议 ASYMMETRIC）----
FEDERATION_TOKEN_MODE=SYMMETRIC

# ---- 同步节奏 ----
FEDERATION_SYNC_INTERVAL_MINUTES=30
FEDERATION_BACKFILL_DAYS=7
FEDERATION_INCLUDE_SELF_IN_AGGREGATE=true
FEDERATION_HEALTH_STALE_MINUTES=0

# ---- 其他 ----
API_PORT=8080
CORS_ORIGIN=http://localhost:5173
PAYMENT_MOCK_ENABLED=false

# ---- 首个管理员（库里没有任何 ADMIN 时创建；已有则跳过）----
# 必须设置, 否则管理后台无人可登录。口令至少 10 位。
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- 短信渠道: None / Aliyun（生产必填, 否则注册与短信登录不可用）----
SMS_PROVIDER=None
SMS_ALIYUN_KEY_ID=
SMS_ALIYUN_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=

# ---- 演示账号: 1 会写入 13800000001/Abc123456 等公开口令账号, 生产必须为 0 ----
SEED_DEMO=0
