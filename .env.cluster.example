# =====================================================================
# 多级节点集群环境变量模板  ->  cp .env.cluster.example .env.cluster
# 生成强密钥:
#   openssl rand -base64 48
# =====================================================================

# ---- 数据库（三个节点共用同一 root/业务账号密码；每个节点各自独立库实例）----
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_USER=agromarket
MYSQL_PASSWORD=change_me_app

# ---- 各节点 API 登录 JWT 密钥（必须 >= 32 字节）----
#   注意: 各节点可各自独立；但如需某个节点签发的用户令牌在别处校验则需一致。
#   一般保持所有节点一致最省心。
JWT_SECRET_KEY=change_me_jwt_secret_at_least_32_bytes_long_0000

# ---- 联动共享密钥（>= 32 字节，所有节点必须完全一致）----
FEDERATION_SHARED_KEY=change_me_federation_shared_key_at_least_32_bytes

# ---- 联动同步节奏 ----
FEDERATION_SYNC_INTERVAL_MINUTES=30

# ---- 跨节点汇聚是否把本节点自身纳入"全景"（默认 true）----
FEDERATION_INCLUDE_SELF_IN_AGGREGATE=true

# ---- 对外暴露端口（宿主机）----
API_PORT_HENAN=8080
API_PORT_XIXIAN=8081
API_PORT_HUAIYANG=8082

# ---- CORS 允许的前端来源 ----
CORS_ORIGIN=http://localhost:5173
