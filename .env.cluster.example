# =====================================================================
# 多级节点集群环境变量模板  ->  cp .env.cluster.example .env.cluster
# 生成强密钥:
#   openssl rand -base64 48
# =====================================================================

# ---- 数据库（三个节点共用同一 root/业务账号密码；每个节点各自独立库实例）----
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_USER=agromarket
MYSQL_PASSWORD=change_me_app

# ---- 各节点 API 登录 JWT 密钥（必须 >= 32 字节）----
#   注意: 各节点可各自独立；但如需某个节点签发的用户令牌在别处校验则需一致。
#   一般保持所有节点一致最省心。
JWT_SECRET_KEY=change_me_jwt_secret_at_least_32_bytes_long_0000

# ---- 联动共享密钥（>= 32 字节，所有节点必须完全一致；SYMMETRIC 模式使用）----
FEDERATION_SHARED_KEY=change_me_federation_shared_key_at_least_32_bytes

# ---- 节点令牌签名模式: SYMMETRIC(HS256 共享密钥) / ASYMMETRIC(RS256 每节点密钥对) ----
#   ASYMMETRIC 更安全: 各节点独立私钥, 单点泄露不再可伪造全网令牌; 需在各节点生成密钥对并互相拉取公钥。
FEDERATION_TOKEN_MODE=SYMMETRIC

# ---- 联动同步节奏 ----
FEDERATION_SYNC_INTERVAL_MINUTES=30

# ---- 每次回补历史天数(含当天): 建议 >= 7, 防止节点中断 >1 天导致指标永久缺失 ----
FEDERATION_BACKFILL_DAYS=7

# ---- 跨节点汇聚是否把本节点自身纳入"全景"（默认 true）----
FEDERATION_INCLUDE_SELF_IN_AGGREGATE=true

# ---- 对端同步"过期"阈值(分钟): 0 = 自动取 max(2*同步间隔, 60) ----
FEDERATION_HEALTH_STALE_MINUTES=0

# ---- 对外暴露端口（宿主机）----
API_PORT_HENAN=8080
API_PORT_ZHOUKOU=8083
API_PORT_XIXIAN=8081
API_PORT_HUAIYANG=8082

# ---- CORS 允许的前端来源 ----
CORS_ORIGIN=http://localhost:5173
